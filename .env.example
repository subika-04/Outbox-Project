# App Config
NODE_ENV=development
PORT=9000

# Database (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=reachinbox
MYSQL_USER=reachinbox_user
MYSQL_PASSWORD=reachinbox_password
DATABASE_URL=mysql://reachinbox_user:reachinbox_password@localhost:3306/reachinbox

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:9000/auth/google/callback

# Slack OAuth
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:9000/api/slack/callback

# Session & Security
SESSION_SECRET=a_very_long_secure_session_secret_key_here
ENCRYPTION_KEY=32_byte_hex_encryption_key_for_secrets_at_rest_here
ADMIN_EMAIL=admin@example.com

# SMTP (Ethereal or real)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your_ethereal_user
ETHEREAL_PASSWORD=your_ethereal_password

# Worker Configuration
WORKER_CONCURRENCY=10
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
